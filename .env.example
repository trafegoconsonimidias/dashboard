# Produção recomendada: planilha-mãe CONFIG + Service Account em JSON.
GOOGLE_SERVICE_ACCOUNT_JSON=
MASTER_SHEET_ID=
MASTER_CONFIG_RANGE=A:Z
MASTER_TEST_RANGE=A:Z

# Formato aceito na primeira aba da planilha-mãe:
# id_cliente | name_cliente | id_planilha | name_planilha | range | tipo | ativo | mapper | access_id
# Se access_id estiver vazio/ausente, o dashboard usa id_cliente como link provisório.

# Opcional: se você preferir duas abas em vez de aba única.
MASTER_CLIENTS_RANGE=CLIENTES!A:Z
MASTER_SHEETS_RANGE=PLANILHAS!A:Z

# Fallback local/legado: uma única planilha, usado somente quando MASTER_SHEET_ID não existe.
GOOGLE_SHEETS_ID=
GOOGLE_SHEETS_SHEET_NAME=Dashboard
GOOGLE_SHEETS_RANGE=A:Z
GOOGLE_SHEETS_API_KEY=
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

DASHBOARD_CLIENT_NAME=Google Sheets
DASHBOARD_CLIENT_SLUG=planilha
DASHBOARD_TITLE=Dashboard da Planilha
DASHBOARD_REFRESH_SECONDS=15

# Opcional: controla quais quadrados aparecem primeiro.
DASHBOARD_TILE_CONFIG='[
  {"source":"[PRODUTO X] Vendas"},
  {"source":"[PRODUTO X] Investimento"},
  {"source":"[PRODUTO X] ROAS"},
  {"source":"Investimento Total"},
  {"source":"Receita Estimada por ads"},
  {"source":"ROAS"}
]'

# Opcional: mappers customizados por JSON, além dos mappers internos meta_v1/google_v1/ecommerce_v1/crm_v1.
DASHBOARD_FIELD_MAPPERS=
